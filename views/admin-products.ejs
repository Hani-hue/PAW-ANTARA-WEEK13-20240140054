<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kelola Produk - <%= storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('partials/nav', { storeName, active: 'admin' }) %>

  <main class="max-w-5xl mx-auto px-4 pb-10">
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-semibold text-gray-700">Daftar Produk (<%= products.length %>)</h2>
      <a
        href="/admin/products/new"
        class="px-3 py-1.5 text-sm rounded-lg font-medium bg-blue-600 text-white hover:bg-blue-700"
      >+ Tambah Produk</a>
    </div>

    <% if (error) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3 mb-4">
        <%= error %>
      </div>
    <% } %>

    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <table class="w-full text-sm text-left">
        <thead class="bg-gray-100 text-gray-600">
          <tr>
            <th class="px-4 py-2">ID</th>
            <th class="px-4 py-2">Nama</th>
            <th class="px-4 py-2">Harga</th>
            <th class="px-4 py-2">Stok</th>
            <th class="px-4 py-2 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(function(p) { %>
            <tr class="border-t border-gray-100">
              <td class="px-4 py-2 text-gray-500">#<%= p.id %></td>
              <td class="px-4 py-2 font-medium text-gray-800"><%= p.name %></td>
              <td class="px-4 py-2">Rp<%= p.price.toLocaleString('id-ID') %></td>
              <td class="px-4 py-2"><%= p.stock %></td>
              <td class="px-4 py-2 text-right space-x-2">
                <a
                  href="/admin/products/<%= p.id %>/edit"
                  class="px-2.5 py-1 text-xs rounded-lg font-medium bg-gray-100 text-gray-600 hover:bg-gray-200"
                >Edit</a>
                <form method="POST" action="/admin/products/<%= p.id %>/delete" class="inline"
                  onsubmit="return confirm('Yakin mau hapus produk ini?');">
                  <button
                    type="submit"
                    class="px-2.5 py-1 text-xs rounded-lg font-medium bg-red-50 text-red-600 hover:bg-red-100"
                  >Hapus</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
