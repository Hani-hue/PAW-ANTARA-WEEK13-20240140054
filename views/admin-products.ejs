<%- include('partials/header', { title: 'Kelola Produk', active: 'admin' }) %>

  <main class="max-w-5xl mx-auto px-4 pb-10">
    <div class="flex items-center justify-between mb-5">
      <h2 class="font-bold text-lg" style="color:#1B4EF5">📦 Daftar Produk (<%= products.length %>)</h2>
      <a
        href="/admin/products/new"
        class="px-4 py-2 text-sm rounded-xl font-semibold text-white transition-all hover:opacity-90 shadow"
        style="background:linear-gradient(135deg,#1B4EF5,#3874FF)"
      >+ Tambah Produk</a>
    </div>

    <% if (error) { %>
      <div class="rounded-xl px-4 py-3 mb-4 text-sm font-medium" style="background:#fff0f0;border:1px solid #fca5a5;color:#dc2626">
        <%= error %>
      </div>
    <% } %>

    <div class="rounded-2xl overflow-hidden shadow-sm" style="background:#fff;border:1px solid #c4d6ff">
      <table class="w-full text-sm text-left">
        <thead>
          <tr style="background:linear-gradient(135deg,#1B4EF5,#3874FF);color:#fff">
            <th class="px-4 py-3">ID</th>
            <th class="px-4 py-3">Nama</th>
            <th class="px-4 py-3">Harga</th>
            <th class="px-4 py-3">Stok</th>
            <th class="px-4 py-3 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(function(p) { %>
            <tr class="transition-colors hover:bg-blue-50" style="border-top:1px solid #e0eaff">
              <td class="px-4 py-3" style="color:#5996FF">#<%= p.id %></td>
              <td class="px-4 py-3 font-medium" style="color:#1B4EF5"><%= p.name %></td>
              <td class="px-4 py-3" style="color:#3874FF">Rp<%= p.price.toLocaleString('id-ID') %></td>
              <td class="px-4 py-3" style="color:#3874FF"><%= p.stock %></td>
              <td class="px-4 py-3 text-right space-x-2">
                <a
                  href="/admin/products/<%= p.id %>/edit"
                  class="inline-block px-3 py-1 text-xs rounded-lg font-semibold transition-all hover:opacity-80"
                  style="background:#F4CEFF;color:#1B4EF5"
                >Edit</a>
                <form method="POST" action="/admin/products/<%= p.id %>/delete" class="inline"
                  onsubmit="return confirm('Yakin mau hapus produk ini?');">
                  <button
                    type="submit"
                    class="px-3 py-1 text-xs rounded-lg font-semibold transition-all hover:opacity-80"
                    style="background:#fff0f0;color:#dc2626;border:1px solid #fca5a5"
                  >Hapus</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
<%- include('partials/footer') %>
