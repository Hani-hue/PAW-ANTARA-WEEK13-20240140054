<%- include('partials/header', { 
  title: 'Login',
  hideNav: true,
  extraCss: `input:focus { outline: none; box-shadow: 0 0 0 2px #5996FF; border-color: #5996FF !important; }`
}) %>
<div class="min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-sm rounded-2xl p-8 shadow-lg" style="background:#fff;border:1px solid #c4d6ff">

    <!-- Logo / Icon -->
    <div class="flex justify-center mb-4">
      <div class="w-12 h-12 rounded-xl flex items-center justify-center text-white text-2xl shadow" style="background:linear-gradient(135deg,#1B4EF5,#3874FF)">🛍</div>
    </div>

    <h1 class="text-2xl font-bold text-center mb-1" style="color:#1B4EF5">Masuk</h1>
    <p class="text-sm text-center mb-6" style="color:#5996FF">Login buat belanja atau kelola toko (admin).</p>

    <% if (error) { %>
      <div class="rounded-xl px-4 py-3 mb-4 text-sm font-medium" style="background:#fff0f0;border:1px solid #fca5a5;color:#dc2626">
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/login" class="space-y-4">
      <div>
        <label class="text-sm font-medium block mb-1" style="color:#3874FF">Username</label>
        <input
          type="text"
          name="username"
          required
          class="w-full px-4 py-2.5 rounded-xl text-sm"
          style="border:1px solid #c4d6ff;color:#1B4EF5;background:#f8f9ff"
        />
      </div>
      <div>
        <label class="text-sm font-medium block mb-1" style="color:#3874FF">Password</label>
        <input
          type="password"
          name="password"
          required
          class="w-full px-4 py-2.5 rounded-xl text-sm"
          style="border:1px solid #c4d6ff;color:#1B4EF5;background:#f8f9ff"
        />
      </div>
      <button
        type="submit"
        class="w-full text-white text-sm font-semibold py-2.5 rounded-xl mt-2 transition-all hover:opacity-90 shadow"
        style="background:linear-gradient(135deg,#1B4EF5,#3874FF)"
      >Masuk →</button>
    </form>

    <p class="text-sm text-center mt-5" style="color:#5996FF">
      Belum punya akun? <a href="/register" class="font-semibold hover:underline" style="color:#1B4EF5">Daftar</a>
    </p>
  </div>
</div>
<%- include('partials/footer') %>
