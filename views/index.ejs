<%- include('partials/header', { 
  active: 'katalog', 
  extraCss: `
    .chat-bubble-user { background: linear-gradient(135deg,#1B4EF5,#3874FF); color:#fff; border-radius:18px 18px 4px 18px; }
    .chat-bubble-bot  { background: #F4CEFF; color:#1B4EF5; border-radius:18px 18px 18px 4px; }
    input:focus, textarea:focus { outline:none; box-shadow:0 0 0 2px #5996FF; border-color:#5996FF !important; }
  `
}) %>

  <main class="max-w-5xl mx-auto px-4 pb-10 grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- KATALOG -->
    <section class="lg:col-span-2">
      <% if (error) { %>
        <div class="rounded-xl px-4 py-3 mb-4 text-sm font-medium" style="background:#fff0f0;border:1px solid #fca5a5;color:#dc2626">
          <%= error %>
        </div>
      <% } %>

      <h2 class="font-bold text-lg mb-4" style="color:#1B4EF5">🛍️ Produk Kami</h2>
      <div id="product-list" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% products.forEach(function(product) { %>
          <%- include('partials/product-card', { product }) %>
        <% }) %>
      </div>
      <p class="text-xs mt-4" style="color:#5996FF">
        Bisa pesan langsung lewat form di atas, ATAU chat sama asisten AI di samping →
        bandingin produk, minta rekomendasi, terus bilang aja mau beli.
      </p>
    </section>

    <!-- CHAT WIDGET -->
    <section class="rounded-2xl flex flex-col h-[600px] sticky top-6 shadow-md" style="background:#fff;border:1px solid #c4d6ff">
      <div class="px-4 py-3 rounded-t-2xl" style="background:linear-gradient(135deg,#1B4EF5,#3874FF)">
        <h2 class="font-bold text-white">💬 Tanya / Pesan lewat Chat</h2>
        <p class="text-xs mt-0.5" style="color:#F4CEFF">Coba: "bagusan produk A apa B?" atau "aku beli produk A 3 biji atas nama Budi"</p>
      </div>

      <div id="chat-messages" class="flex-1 overflow-y-auto px-4 py-3 space-y-3"></div>

      <form id="chat-form" class="p-3 flex gap-2" style="border-top:1px solid #e0eaff">
        <input
          id="chat-input"
          type="text"
          placeholder="Tanya atau pesan produk..."
          class="flex-1 rounded-xl px-3 py-2 text-sm"
          style="border:1px solid #c4d6ff;color:#1B4EF5"
          autocomplete="off"
        />
        <button
          id="chat-submit"
          type="submit"
          class="text-white px-4 py-2 rounded-xl text-sm font-semibold transition-all hover:opacity-90"
          style="background:linear-gradient(135deg,#1B4EF5,#3874FF)"
        >Kirim</button>
      </form>
    </section>

  </main>

  <script src="/js/store.js"></script>
  <script src="/js/utils/formatChatText.js"></script>
  <script src="/js/chat.js"></script>
<%- include('partials/footer') %>
