<%- include('partials/header', { title: 'Kelola Invoice', active: 'admin-invoice' }) %>

  <main class="max-w-5xl mx-auto px-4 pb-10">
    <h2 class="font-bold text-lg mb-5" style="color:#1B4EF5">🧾 Kelola Invoice & Status Pesanan</h2>

    <% if (success) { %>
      <div class="rounded-xl px-4 py-3 mb-4 text-sm font-medium" style="background:#f0fff4;border:1px solid #86efac;color:#15803d">
        <%= success %>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="rounded-xl px-4 py-3 mb-4 text-sm font-medium" style="background:#fff0f0;border:1px solid #fca5a5;color:#dc2626">
        <%= error %>
      </div>
    <% } %>

    <% if (orders.length === 0) { %>
      <div class="text-center py-16 rounded-2xl" style="background:#fff;border:1px solid #c4d6ff">
        <div class="text-4xl mb-3">📭</div>
        <p style="color:#5996FF">Belum ada order masuk.</p>
      </div>
    <% } %>

    <div class="rounded-2xl overflow-hidden shadow-sm" style="background:#fff;border:1px solid #c4d6ff">
      <% if (orders.length > 0) { %>
      <table class="w-full text-sm text-left">
        <thead>
          <tr style="background:linear-gradient(135deg,#1B4EF5,#3874FF);color:#fff">
            <th class="px-4 py-3">Invoice</th>
            <th class="px-4 py-3">Produk</th>
            <th class="px-4 py-3">Pembeli</th>
            <th class="px-4 py-3">Qty</th>
            <th class="px-4 py-3">Total</th>
            <th class="px-4 py-3">Tanggal</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3 text-right">Ubah Status</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(function(order) { %>
            <%
              const statusColors = {
                pending:    'background:#fff9e0;color:#b45309;border:1px solid #fcd34d',
                processing: 'background:#eff6ff;color:#1d4ed8;border:1px solid #93c5fd',
                shipped:    'background:#f0fdf4;color:#15803d;border:1px solid #86efac',
                completed:  'background:#f0fdf4;color:#166534;border:1px solid #4ade80',
                cancelled:  'background:#fff0f0;color:#dc2626;border:1px solid #fca5a5',
              };
              const badgeStyle = statusColors[order.status] || statusColors.pending;
            %>
            <tr class="transition-colors hover:bg-blue-50" style="border-top:1px solid #e0eaff">
              <td class="px-4 py-3 font-bold" style="color:#1B4EF5">
                INV-<%= String(order.id).padStart(5, '0') %>
              </td>
              <td class="px-4 py-3" style="color:#3874FF">
                <%= order.Product ? order.Product.name : '(produk dihapus)' %>
              </td>
              <td class="px-4 py-3" style="color:#3874FF"><%= order.buyerName %></td>
              <td class="px-4 py-3" style="color:#3874FF"><%= order.quantity %></td>
              <td class="px-4 py-3" style="color:#3874FF">
                <% if (order.Product) { %>
                  Rp<%= (order.Product.price * order.quantity).toLocaleString('id-ID') %>
                <% } else { %>
                  -
                <% } %>
              </td>
              <td class="px-4 py-3 text-xs" style="color:#5996FF">
                <%= new Date(order.createdAt).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %>
              </td>
              <td class="px-4 py-3">
                <span class="inline-block px-2.5 py-0.5 text-xs rounded-full font-medium" style="<%= badgeStyle %>">
                  <%= order.status %>
                </span>
              </td>
              <td class="px-4 py-3 text-right">
                <form method="POST" action="/admin/invoices/<%= order.id %>/status" class="flex items-center justify-end gap-2">
                  <select
                    name="status"
                    class="text-xs rounded-lg px-2 py-1.5 border"
                    style="border-color:#c4d6ff;color:#1B4EF5"
                  >
                    <% ['pending','processing','shipped','completed','cancelled'].forEach(function(s) { %>
                      <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option>
                    <% }) %>
                  </select>
                  <button
                    type="submit"
                    class="text-xs px-3 py-1.5 rounded-lg font-semibold text-white transition-all hover:opacity-90"
                    style="background:linear-gradient(135deg,#1B4EF5,#3874FF)"
                  >Simpan</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </main>
<%- include('partials/footer') %>
