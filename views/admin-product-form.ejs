<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= mode === 'edit' ? 'Edit' : 'Tambah' %> Produk - <%= storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('partials/nav', { storeName, active: 'admin' }) %>

  <main class="max-w-lg mx-auto px-4 pb-10">
    <h2 class="font-semibold text-gray-700 mb-3">
      <%= mode === 'edit' ? 'Edit Produk' : 'Tambah Produk Baru' %>
    </h2>

    <% if (error) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3 mb-4">
        <%= error %>
      </div>
    <% } %>

    <form
      method="POST"
      action="<%= mode === 'edit' ? '/admin/products/' + product.id : '/admin/products' %>"
      class="bg-white border border-gray-200 rounded-xl p-5 space-y-3"
    >
      <div>
        <label class="text-sm text-gray-600">Nama Produk</label>
        <input
          type="text"
          name="name"
          required
          value="<%= product ? product.name : '' %>"
          class="w-full mt-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <div>
        <label class="text-sm text-gray-600">Deskripsi</label>
        <textarea
          name="description"
          rows="3"
          class="w-full mt-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
        ><%= product && product.description ? product.description : '' %></textarea>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="text-sm text-gray-600">Harga (Rp)</label>
          <input
            type="number"
            name="price"
            min="0"
            required
            value="<%= product ? product.price : '' %>"
            class="w-full mt-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>
        <div>
          <label class="text-sm text-gray-600">Stok</label>
          <input
            type="number"
            name="stock"
            min="0"
            required
            value="<%= product ? product.stock : 0 %>"
            class="w-full mt-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>
      </div>

      <div class="flex gap-2 pt-2">
        <button
          type="submit"
          class="flex-1 bg-blue-600 text-white text-sm font-medium py-2 rounded-lg hover:bg-blue-700"
        ><%= mode === 'edit' ? 'Simpan Perubahan' : 'Tambah Produk' %></button>
        <a
          href="/admin/products"
          class="px-4 py-2 text-sm rounded-lg font-medium bg-gray-100 text-gray-600 hover:bg-gray-200"
        >Batal</a>
      </div>
    </form>
  </main>
</body>
</html>
