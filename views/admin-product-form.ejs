<%- include('partials/header', { 
  title: (mode === 'edit' ? 'Edit' : 'Tambah') + ' Produk', 
  active: 'admin',
  extraCss: `input:focus, textarea:focus { outline: none; box-shadow: 0 0 0 2px #5996FF; border-color: #5996FF !important; }`
}) %>

  <main class="max-w-lg mx-auto px-4 pb-10">
    <h2 class="font-bold text-lg mb-5" style="color:#1B4EF5">
      <%= mode === 'edit' ? '✏️ Edit Produk' : '➕ Tambah Produk Baru' %>
    </h2>

    <% if (error) { %>
      <div class="rounded-xl px-4 py-3 mb-4 text-sm font-medium" style="background:#fff0f0;border:1px solid #fca5a5;color:#dc2626">
        <%= error %>
      </div>
    <% } %>

    <form
      method="POST"
      action="<%= mode === 'edit' ? '/admin/products/' + product.id : '/admin/products' %>"
      class="rounded-2xl p-6 shadow-sm space-y-4"
      style="background:#fff;border:1px solid #c4d6ff"
    >
      <div>
        <label class="text-sm font-medium block mb-1" style="color:#3874FF">Nama Produk</label>
        <input
          type="text"
          name="name"
          required
          value="<%= product ? product.name : '' %>"
          class="w-full px-4 py-2.5 rounded-xl text-sm"
          style="border:1px solid #c4d6ff;color:#1B4EF5;background:#f8f9ff"
        />
      </div>
      <div>
        <label class="text-sm font-medium block mb-1" style="color:#3874FF">Deskripsi</label>
        <textarea
          name="description"
          rows="3"
          class="w-full px-4 py-2.5 rounded-xl text-sm resize-none"
          style="border:1px solid #c4d6ff;color:#1B4EF5;background:#f8f9ff"
        ><%= product && product.description ? product.description : '' %></textarea>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="text-sm font-medium block mb-1" style="color:#3874FF">Harga (Rp)</label>
          <input
            type="number"
            name="price"
            min="0"
            required
            value="<%= product ? product.price : '' %>"
            class="w-full px-4 py-2.5 rounded-xl text-sm"
            style="border:1px solid #c4d6ff;color:#1B4EF5;background:#f8f9ff"
          />
        </div>
        <div>
          <label class="text-sm font-medium block mb-1" style="color:#3874FF">Stok</label>
          <input
            type="number"
            name="stock"
            min="0"
            required
            value="<%= product ? product.stock : 0 %>"
            class="w-full px-4 py-2.5 rounded-xl text-sm"
            style="border:1px solid #c4d6ff;color:#1B4EF5;background:#f8f9ff"
          />
        </div>
      </div>

      <div class="flex gap-3 pt-2">
        <button
          type="submit"
          class="flex-1 text-white text-sm font-semibold py-2.5 rounded-xl transition-all hover:opacity-90 shadow"
          style="background:linear-gradient(135deg,#1B4EF5,#3874FF)"
        ><%= mode === 'edit' ? 'Simpan Perubahan' : 'Tambah Produk' %></button>
        <a
          href="/admin/products"
          class="px-5 py-2.5 text-sm rounded-xl font-medium transition-all hover:opacity-80"
          style="background:#F4CEFF;color:#1B4EF5"
        >Batal</a>
      </div>
    </form>
  </main>
<%- include('partials/footer') %>
