<%- include('partials/header', { 
  title: 'Order Berhasil',
  hideNav: true
}) %>
<div class="min-h-screen flex items-center justify-center px-4">
  <div class="rounded-2xl p-8 w-full max-w-sm text-center shadow-lg" style="background:#fff;border:1px solid #c4d6ff">

    <!-- Success Icon -->
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 rounded-full flex items-center justify-center text-3xl shadow" style="background:linear-gradient(135deg,#1B4EF5,#5996FF)">✅</div>
    </div>

    <h1 class="text-xl font-bold mb-1" style="color:#1B4EF5">Order Berhasil!</h1>
    <p class="text-sm mb-5" style="color:#5996FF">Admin <strong><%= storeName %></strong> udah dapet notifikasi order kamu</p>

    <div class="rounded-xl p-4 text-left text-sm space-y-1.5 mb-5" style="background:#f8f9ff;border:1px solid #c4d6ff">
      <p><span class="font-semibold" style="color:#1B4EF5">Order ID:</span> <span style="color:#3874FF">#<%= order.id %></span></p>
      <p><span class="font-semibold" style="color:#1B4EF5">Produk:</span> <span style="color:#3874FF"><%= product.name %></span></p>
      <p><span class="font-semibold" style="color:#1B4EF5">Jumlah:</span> <span style="color:#3874FF"><%= order.quantity %></span></p>
      <p><span class="font-semibold" style="color:#1B4EF5">Total:</span> <span class="font-bold" style="color:#3874FF">Rp<%= (product.price * order.quantity).toLocaleString('id-ID') %></span></p>
      <p><span class="font-semibold" style="color:#1B4EF5">Atas nama:</span> <span style="color:#3874FF"><%= order.buyerName %></span></p>
    </div>

    <p class="text-xs mb-5" style="color:#5996FF">Admin bakal segera menghubungi kamu buat konfirmasi pembayaran & pengiriman.</p>

    <a href="/" class="block w-full text-white text-sm font-semibold py-2.5 rounded-xl transition-all hover:opacity-90 shadow" style="background:linear-gradient(135deg,#1B4EF5,#3874FF)">
      ← Balik ke Katalog
    </a>
  </div>
</div>
<%- include('partials/footer') %>
