<%
const isAvailable = product.stock > 0;
const badgeLabel = isAvailable ? `Stok: ${product.stock}` : 'Habis';
const badgeColor = isAvailable ? 'green' : 'red';
%>
<div class="rounded-2xl p-4 shadow-sm border transition-all hover:shadow-md" style="background:#fff;border-color:#e0eaff">
  <div class="flex items-start justify-between mb-2">
    <h3 class="font-semibold" style="color:#1B4EF5"><%= product.name %></h3>
    <%- include('badge', { label: badgeLabel, color: badgeColor }) %>
  </div>
  <p class="text-sm mb-3" style="color:#5996FF"><%= product.description || 'Tanpa deskripsi' %></p>
  <p class="font-bold mb-3 text-base" style="color:#3874FF">Rp<%= product.price.toLocaleString('id-ID') %></p>

  <% if (isAvailable) { %>
    <form method="POST" action="/order" class="space-y-2">
      <input type="hidden" name="productId" value="<%= product.id %>" />
      <input
        type="text"
        name="buyerName"
        placeholder="Nama kamu"
        required
        class="w-full rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2"
        style="border:1px solid #c4d6ff;color:#1B4EF5;focus-ring-color:#3874FF"
      />
      <div class="flex gap-2">
        <input
          type="number"
          name="quantity"
          value="1"
          min="1"
          max="<%= product.stock %>"
          required
          class="w-20 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2"
          style="border:1px solid #c4d6ff;color:#1B4EF5"
        />
        <button type="submit" class="flex-1 text-white text-sm font-semibold rounded-lg py-2 transition-all hover:opacity-90" style="background:linear-gradient(135deg,#1B4EF5,#3874FF)">
          Pesan Sekarang
        </button>
      </div>
    </form>
  <% } else { %>
    <button disabled class="w-full text-sm font-semibold py-2 rounded-lg cursor-not-allowed" style="background:#f3f3f3;color:#aaa">
      Stok Habis
    </button>
  <% } %>
</div>
