<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' - ' + storeName : storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background: linear-gradient(135deg, #f0f4ff 0%, #faf0ff 100%); }
    <%- typeof extraCss !== 'undefined' ? extraCss : '' %>
  </style>
</head>
<body class="min-h-screen">
  <% if (typeof hideNav === 'undefined' || !hideNav) { %>
    <%- include('nav', { active: typeof active !== 'undefined' ? active : '' }) %>
  <% } %>
