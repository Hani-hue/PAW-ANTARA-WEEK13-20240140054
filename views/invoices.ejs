<%- include('partials/header', { title: 'Invoice', active: 'invoice' }) %>

  <main class="max-w-3xl mx-auto px-4 pb-10">
    <h2 class="font-bold text-lg mb-5" style="color:#1B4EF5">🧾 Riwayat Invoice</h2>

    <% if (orders.length === 0) { %>
      <div class="text-center py-16 rounded-2xl" style="background:#fff;border:1px solid #c4d6ff">
        <div class="text-4xl mb-3">📭</div>
        <p style="color:#5996FF">Belum ada order masuk.</p>
      </div>
    <% } %>

    <div class="space-y-4">
      <% orders.forEach(function(order) { %>
        <div class="rounded-2xl p-5 shadow-sm transition-all hover:shadow-md" style="background:#fff;border:1px solid #c4d6ff">
          <div class="flex items-center justify-between mb-3">
            <span class="font-bold text-base" style="color:#1B4EF5">INV-<%= String(order.id).padStart(5, '0') %></span>
            <span class="text-xs px-3 py-1 rounded-full" style="background:#F4CEFF;color:#3874FF">
              <%= new Date(order.createdAt).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %>
            </span>
          </div>
          <div class="text-sm space-y-1.5" style="color:#3874FF">
            <p><span class="font-semibold" style="color:#1B4EF5">Produk:</span> <%= order.Product ? order.Product.name : '(produk dihapus)' %></p>
            <p><span class="font-semibold" style="color:#1B4EF5">Jumlah:</span> <%= order.quantity %></p>
            <% if (order.Product) { %>
              <p><span class="font-semibold" style="color:#1B4EF5">Total:</span> Rp<%= (order.Product.price * order.quantity).toLocaleString('id-ID') %></p>
            <% } %>
            <p><span class="font-semibold" style="color:#1B4EF5">Atas nama:</span> <%= order.buyerName %></p>
            <p>
              <span class="font-semibold" style="color:#1B4EF5">Status:</span>
              <span class="inline-block px-2.5 py-0.5 text-xs rounded-full ml-1" style="background:#fff9e0;color:#b45309;border:1px solid #fcd34d"><%= order.status %></span>
            </p>
          </div>
        </div>
      <% }) %>
    </div>
  </main>
<%- include('partials/footer') %>
